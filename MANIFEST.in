include LICENSE
include README.md
include setup.py
include pyproject.toml

recursive-include rulease *.py *.sql
recursive-include ruleas *.py
recursive-include examples *.rulea *.json *.py
recursive-include tests *.py

exclude *.pyc
exclude __pycache__/

include compose.yaml
recursive-include ruleas *.html

recursive-include scripts *.sh
include .github/branch-protection.json

include docs-v2-status.md

include docs-auth-tenant.md
