include LICENSE
include README.md
include setup.py
include pyproject.toml

recursive-include rulea *.py
recursive-include ruleas *.py
recursive-include examples *.rulea *.json *.py
recursive-include tests *.py

exclude *.pyc
exclude __pycache__/

include compose.yaml
recursive-include ruleas *.html

recursive-include scripts *.sh
include .github/branch-protection.json
